{
  "name": "qianji-workers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "types": "wrangler types --env-interface WorkerEnv",
    "typecheck": "pnpm types && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "acceptance": "node tools/acceptance/run.mts",
    "acceptance:dev": "vite --config tools/acceptance/vite.config.mts",
    "acceptance:idle": "node tools/acceptance/idle.mts",
    "ops": "node tools/ops/maintenance.mts",
    "check:deploy": "wrangler deploy --dry-run --config dist/worker/wrangler.json",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm check:deploy"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@modelcontextprotocol/server": "2.3.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "decimal.js": "10.6.0",
    "lossless-json": "4.3.2",
    "lucide-react": "1.59.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.22.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-plugin": "1.4.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
