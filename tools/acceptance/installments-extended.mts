import {DomainError} from '../../src/shared/errors';
import {addMoney,compareMoney,subtractMoney} from '../../src/shared/numbers';
import {assetInfoKey} from '../../src/features/assets/service';
import {installmentKey} from '../../src/features/installments/source';
import type {CaseEnvironment} from './cases.mts';
const check=(value:unknown,message:string)=>{if(!value)throw new DomainError('ACCEPTANCE_READBACK_MISMATCH',message);};
const one=(op:Awaited<ReturnType<CaseEnvironment['write']>>)=>{const ids=Object.values(op.idMap);check(ids.length===1,'新建测试资源缺少唯一ID');return ids[0]!;};
async function asset(e:CaseEnvironment,alias:string){const id=e.known(alias);e.invalidateSource(assetInfoKey(id));const row=(await e.read('assets.detail',{id},true)).asset;check(row,'新测试资产缺失');return row!;}
async function plan(e:CaseEnvironment,alias:string){e.invalidateSource(installmentKey());const row=(await e.read('installments.list',{sort:0,ascending:false})).items.find(row=>row.id===e.known(alias));check(row,'新测试分期缺失');return row!;}
async function createCard(e:CaseEnvironment,alias:string,currency:string){const def=(await e.read('assets.types',{})).items.find(row=>row.type===2);check(def,'缺少官方信用卡类型');await e.phase(alias+'-create',async()=>{e.remember(alias,'asset',one(await e.write(alias+'-create','assets.submit',{mode:'create',fields:{name:e.prefix+(currency==='USD'?'外币提前还卡':'历史分期卡'),type:2,subtype:def!.subtype,currency,money:'0',inCount:false,credit:{limit:'100',statementDay:1,paymentDay:10,statementIncludesPrevious:false}}})));});}
export async function runInstallmentHistory(e:CaseEnvironment){
 await e.synchronize();const label='installment-history';await createCard(e,label+'-card','CNY');
 await e.phase(label+'-create',async()=>{const result=await e.write(label+'-create','installments.create',{name:e.prefix+'历史初始期',bookId:e.known('book'),assetId:e.known(label+'-card'),categoryId:e.known('expense-category'),totalMoney:'0.03',totalFee:'0',totalCount:3,firstDate:'2026-09-30',images:[e.known('image-bill')],tagIds:[e.known('tag')],remark:e.prefix+'历史初始进度'});e.remember(label,'installment',one(result));await e.synchronize();const row=await plan(e,label);check(row.count===1,'历史日期的原生初始计数应为1');const ids=result.affectedIds.filter(id=>/^[1-9]\d+$/.test(id));for(const [index,id]of ids.entries()){e.remember(label+'-bill-'+index,'bill',id);const bill=await e.read('ledger.detail',{id});check(bill.packId===row.packId&&bill.type===0,'官方初始账单未属于本次分期');}e.checkpoint(label+'-initial-bills',ids);});
 await e.phase(label+'-cleanup',async()=>{const row=await plan(e,label);await e.write(label+'-delete','installments.delete',{id:row.id,expectedVersion:row.editVersion});for(const id of e.checkpoint<string[]>(label+'-initial-bills',[])){const bill=await e.read('ledger.detail',{id});await e.write(label+'-delete-bill-'+id,'ledger.delete',{bills:[{id,expectedVersion:bill.editVersion}]});}await e.synchronize();const card=await asset(e,label+'-card');await e.write(label+'-delete-card','assets.delete',{id:card.id,expectedVersion:card.editVersion});});
 return {state:'ready',historicalInitialCount:1,officialGeneratedBills:e.checkpoint<string[]>(label+'-initial-bills',[]).length,onlyOfficialBillsUsed:true};
}
export async function runInstallmentForeignPrepay(e:CaseEnvironment,encoding:'json-string'|'array'='json-string'){
 await e.synchronize();await e.phase('prepay-truncated-card-cleanup',async()=>{const old=await e.write('installment-fx-prepay-card-create','assets.submit',{},['ASSET_NAME_TRUNCATED']);e.remember('prepay-truncated-card','asset',one(old));const row=await asset(e,'prepay-truncated-card');await e.write('prepay-truncated-card-delete','assets.delete',{id:row.id,expectedVersion:row.editVersion});});const label=encoding==='array'?'installment-fx-array-prepay':'installment-fx-native-prepay';await createCard(e,label+'-card','USD');const before=e.checkpoint(label+'-cash-before',(await asset(e,'cash-a')).money);
 await e.phase(label+'-create',async()=>{e.remember(label,'installment',one(await e.write(label+'-create','installments.create',{name:e.prefix+'外币提前还',bookId:e.known('book'),assetId:e.known(label+'-card'),categoryId:e.known('expense-category'),totalMoney:'2',totalFee:'0',totalCount:2,firstDate:'2026-12-31',remark:e.prefix+'外币提前还款'})));});
 await e.phase(label+'-prepay',async()=>{const row=await plan(e,label),result=await e.write(label+'-prepay','installments.prepay',{id:row.id,expectedVersion:row.prepayVersion,bookId:e.known('book'),fromAssetId:e.known('cash-a'),money:'14',fee:'0.07',timeSec:Math.floor(Date.now()/60000)*60,remark:e.prefix+'外币附图提前还款',images:[e.known('image-bill')],spendCurrency:{srcSymbol:'USD',srcValue:'2',targetSymbol:'USD',targetValue:'2',baseSymbol:'CNY',baseValue:'14',srcFee:'0'},transferCurrency:{srcSymbol:'CNY',srcValue:encoding==='array'?'14.07':'14',targetSymbol:'USD',targetValue:'2',baseSymbol:'CNY',baseValue:'14',srcFee:'0.07'}});for(const [key,id]of Object.entries(result.idMap))e.remember(label+(key.includes(':expense:')?'-expense':'-repayment'),'bill',id);await e.synchronize();const after=await plan(e,label);check(after.status===-1&&after.prepaidAtSec>0,'外币提前还款未结清');for(const suffix of ['expense','repayment']){const bill=await e.read('ledger.detail',{id:e.known(label+'-'+suffix)});e.checkpoint(label+'-images-'+suffix,bill.images.includes(e.known('image-bill')));if(encoding==='array')check(bill.images.includes(e.known('image-bill')),'提前还款'+suffix+'图片未保存');check(bill.currency?.targetSymbol==='USD'&&compareMoney(bill.currency.targetValue,'2')===0&&compareMoney(bill.currency.baseValue,'14')===0,'提前还款'+suffix+'历史币种不符');}check(compareMoney((await asset(e,'cash-a')).money,subtractMoney(before,encoding==='array'?'14.07':'14'))===0&&compareMoney((await asset(e,label+'-card')).money,'0')===0,'外币提前还款两端实际余额不符');});
 await e.phase(label+'-cleanup',async()=>{if(e.hasIntent(label+'-delete'))await e.write(label+'-delete','installments.delete',{});else{const row=await plan(e,label);await e.write(label+'-delete','installments.delete',{id:row.id,expectedVersion:row.editVersion});}for(const suffix of ['repayment','expense']){const step=label+(suffix==='repayment'?'-delete-card-bill':'-delete-expense');if(e.hasIntent(step)){await e.write(step,suffix==='repayment'?'ledger.repayCard':'ledger.delete',{});continue;}const bill=await e.read('ledger.detail',{id:e.known(label+'-'+suffix)});if(suffix==='repayment'){if(e.hasIntent(label+'-delete-repayment'))e.requireNotSentFailure(label+'-delete-repayment','BILL_TYPE_UNSUPPORTED');await e.write(step,'ledger.repayCard',{mode:'delete',id:bill.id,expectedVersion:bill.editVersion});}else await e.write(step,'ledger.delete',{bills:[{id:bill.id,expectedVersion:bill.editVersion}]});}await e.synchronize();check(compareMoney((await asset(e,'cash-a')).money,encoding==='array'?before:addMoney(before,'0.07'))===0,'删除测试提前还款账单后现金未恢复');const card=await asset(e,label+'-card');check(compareMoney(card.money,'0')===0,'测试卡余额未恢复');await e.write(label+'-delete-card','assets.delete',{id:card.id,expectedVersion:card.editVersion});});
 return {state:'ready',foreignPrepayExpenseAndRepaymentHistoricalCurrenciesFeeRealBalances:true,encoding,expenseImages:e.checkpoint(label+'-images-expense',false),repaymentImages:e.checkpoint(label+'-images-repayment',false),balancesRestored:encoding==='array',legacyInconsistentGrossSurplus:encoding==='json-string'?'0.07':'0'};
}
export async function inspectInstallmentPrepay(e:CaseEnvironment){const label='installment-fx-native-prepay';return {state:'ready',before:e.checkpoint(label+'-cash-before','not-saved'),cash:await asset(e,'cash-a'),card:await asset(e,label+'-card'),plan:await plan(e,label)};}
