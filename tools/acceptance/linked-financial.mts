 for(const [suffix,money,targetValue,assetAlias]of [['asset','0.4','2.8','cash-b'],['none','0.3','2.1',null]] as const){
  await e.phase(label+'-'+suffix,async()=>{const sources=await Promise.all(['a','b'].map(key=>e.read('ledger.detail',{id:e.known(label+'-'+key)}))),op=await e.write(label+'-'+suffix,'ledger.reimburse',{bills:sources.map(row=>({id:row.id,expectedVersion:row.editVersion})),assetId:assetAlias?e.known(assetAlias):null,money,timeSec:time(),remark:e.prefix+label+suffix,currency:{srcSymbol:'USD',srcValue:money,targetSymbol:'CNY',targetValue,baseSymbol:'CNY',baseValue:targetValue},images:[e.known('image-bill')],tagIds:[e.known('tag')]});
   const ids=Object.values(op.idMap);check(ids.length===2,'两源报销缺少两个官方子记录');for(const [index,id]of ids.entries())e.remember(label+'-'+suffix+'-'+index,'bill',id);await e.synchronize();let total='0';for(const id of ids){const child=await e.read('ledger.detail',{id});check(child.type===21&&child.currency?.srcSymbol==='USD'&&child.images.includes(e.known('image-bill'))&&child.tagIds.includes(e.known('tag')),'报销子记录币种、图片或标签缺失');total=addMoney(total,child.currency!.targetValue);}check(compareMoney(total,targetValue)===0,'报销分配目标币种合计不符');await balances(e,{'cash-usd':subtractMoney(before['cash-usd'],'0.3'),'cash-b':assetAlias?addMoney(before['cash-b'],targetValue):before['cash-b']});
  });
  await e.phase(label+'-'+suffix+'-cancel',async()=>{const sources=await Promise.all(['a','b'].map(key=>e.read('ledger.detail',{id:e.known(label+'-'+key)})));await e.write(label+'-'+suffix+'-cancel','ledger.cancelReimbursement',{bills:sources.map(row=>({id:row.id,expectedVersion:row.editVersion}))});await e.synchronize();for(const row of sources)check((await e.read('ledger.detail',{id:row.id})).reimbursementIds.length===0,'取消报销关系未清除');await balances(e,{'cash-usd':subtractMoney(before['cash-usd'],'0.3'),'cash-b':before['cash-b']});});
 }
