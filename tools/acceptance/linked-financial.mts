const check=(value:unknown,message:string)=>{if(!value)throw new DomainError('ACCEPTANCE_READBACK_MISMATCH',message);};
const time=()=>Math.floor(Date.now()/60000)*60;
const one=(op:Awaited<ReturnType<CaseEnvironment['write']>>)=>{const ids=Object.values(op.idMap);check(ids.length===1,'新建缺少唯一ID');return ids[0]!;};
async function balance(e:CaseEnvironment,alias:string){const id=e.known(alias);e.invalidateSource(assetInfoKey(id));const row=(await e.read('assets.detail',{id},true)).asset;check(row,'测试资产缺失');return row!.money;}
async function base(e:CaseEnvironment,key:string){return e.checkpoint(key,{'cash-usd':await balance(e,'cash-usd'),'cash-b':await balance(e,'cash-b')});}
async function balances(e:CaseEnvironment,expected:Record<string,string>){for(const [alias,money]of Object.entries(expected))check(compareMoney(await balance(e,alias),money)===0,'测试资产余额不符：'+alias);}
export async function inspectForeignRefund(e:CaseEnvironment){const rows=[];for(const suffix of ['a','b','none'])if(e.optional('refund-fx-'+suffix)){const row=await e.read('ledger.detail',{id:e.known('refund-fx-'+suffix)});rows.push({suffix,id:row.id,type:row.type,money:row.money,assetId:row.assetId,currency:row.currency,images:row.images,tagIds:row.tagIds,refundSourceId:row.refundSourceId});}return {state:'ready',rows,expectedSource:e.known('refund-fx-source')};}
