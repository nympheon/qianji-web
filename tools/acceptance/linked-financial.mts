  const source=await e.read('ledger.detail',{id:e.known(label+'-source')}),targetSymbol=assetAlias==='cash-usd'?'USD':assetAlias?'CNY':null;e.remember(label+'-'+suffix,'bill',createdBill(await e.write(label+'-'+suffix,'ledger.refund',{billId:source.id,expectedVersion:source.editVersion,money,assetId:assetAlias?e.known(assetAlias):null,timeSec:time(),remark:e.prefix+label+suffix,currency:{srcSymbol:'USD',srcValue:money,targetSymbol,targetValue,baseSymbol:'CNY',baseValue:suffix==='b'?'0.56':assetAlias?targetValue:'0.07'},tagIds:[e.known('tag')],images:[e.known('image-bill')]})));await e.synchronize();const row=await e.read('ledger.detail',{id:e.known(label+'-'+suffix)});check(row.refundSourceId===source.id&&row.currency?.srcSymbol==='USD'&&compareMoney(row.currency.srcValue,money)===0&&compareMoney(row.currency.targetValue,assetAlias?targetValue:'0')===0&&row.currency.targetSymbol===targetSymbol&&row.images.includes(e.known('image-bill'))&&row.tagIds.includes(e.known('tag')),'外币退款源子关系、历史金额、图片或标签未回拉');
 });
