import {mkdir,writeFile} from 'node:fs/promises';
type Observation={state:string;networkRequests:number;monitorId:string;observedAt:string;lastNetworkAt:string|null};
async function observe():Promise<Observation>{const response=await fetch('http://127.0.0.1:8791/__acceptance',{method:'POST',headers:{'Content-Type':'application/json'},body:'{"case":"status"}',signal:AbortSignal.timeout(20000)});const value=await response.json() as Observation;if(value.state!=='ready'||typeof value.networkRequests!=='number'||!value.monitorId)throw new Error('IDLE_MONITOR_UNAVAILABLE');return value;}
await mkdir('.artifacts/acceptance',{recursive:true});const before=await observe(),start=performance.now();await writeFile('.artifacts/acceptance/idle-start.json',JSON.stringify(before,null,2));console.log('Started a continuous 10-minute local upstream-idle observation.');
await new Promise(resolve=>setTimeout(resolve,600000));const after=await observe(),elapsedMs=performance.now()-start,passed=elapsedMs>=600000&&before.monitorId===after.monitorId&&before.networkRequests===after.networkRequests;
const report={state:passed?'ready':'error',environment:'local-private-worker',elapsedMs,before,after,productionNotTested:true};await writeFile('.artifacts/acceptance/idle.json',JSON.stringify(report,null,2));console.log(JSON.stringify({state:report.state,elapsedMs,upstreamRequestsAdded:after.networkRequests-before.networkRequests,continuousInstance:before.monitorId===after.monitorId}));if(!passed)process.exitCode=1;
