import {DomainError} from '../../src/shared/errors';
import {compareMoney} from '../../src/shared/numbers';
import {assetInfoKey} from '../../src/features/assets/service';
import {createdBill} from './ledger.mts';
import type {CaseEnvironment} from './cases.mts';
export async function runLedgerExtended(e:CaseEnvironment){
 await e.synchronize();await e.read('ledger.transfer.options',{},true);
 const balances:Record<string,string>={};for(const alias of ['cash-a','cash-b','installment-card']){const id=e.known(alias);e.invalidateSource(assetInfoKey(id));const a=(await e.read('assets.detail',{id},true)).asset;if(!a)throw new DomainError('ACCEPTANCE_SOURCE_INCOMPLETE','测试资产缺失');balances[alias]=e.checkpoint('extended-before-'+alias,a.money);}
 const bookId=e.known('book'),timeSec=Math.floor(Date.now()/60000)*60;
 if(!e.optional('extended-expense'))e.remember('extended-expense','bill',createdBill(await e.write('extended-expense-create','ledger.create',{bills:[{bookId,type:0,categoryId:e.known('expense-category'),assetId:e.known('cash-a'),enteredMoney:'0.8',fee:'-0.1',timeSec,remark:e.prefix+'扩展支出'}]})));
 await e.synchronize();let source=await e.read('ledger.detail',{id:e.known('extended-expense')});
 await e.write('extended-expense-edit','ledger.edit',{bills:[{id:source.id,expectedVersion:source.editVersion,changes:{enteredMoney:'1.1',fee:'-0.1',assetId:e.known('cash-b'),categoryId:e.known('batch-category-a'),timeSec:timeSec-60,tagIds:[e.known('tag')],images:[e.known('image-bill')],countInStatistics:false,countInBudget:false,remark:e.prefix+'扩展字段已改'}}]});await e.synchronize();source=await e.read('ledger.detail',{id:source.id});if(compareMoney(source.money,'1')||source.assetId!==e.known('cash-b')||source.flags!==3||source.categoryId!==e.known('batch-category-a')||!source.images.includes(e.known('image-bill')))throw new DomainError('ACCEPTANCE_READBACK_MISMATCH','普通支出完整编辑字段未回拉');
 if(!e.optional('extended-refund'))e.remember('extended-refund','bill',createdBill(await e.write('extended-refund-create','ledger.refund',{billId:source.id,expectedVersion:source.editVersion,money:'0.2',assetId:e.known('cash-a'),timeSec,remark:e.prefix+'扩展退款'})));
 await e.synchronize();source=await e.read('ledger.detail',{id:source.id});let refund=await e.read('ledger.detail',{id:e.known('extended-refund')});await e.write('extended-refund-edit','ledger.refund',{billId:source.id,expectedVersion:source.editVersion,refundBillId:refund.id,refundExpectedVersion:refund.editVersion,money:'0.1',assetId:e.known('cash-b'),timeSec,remark:e.prefix+'退款已编辑'});await e.synchronize();refund=await e.read('ledger.detail',{id:refund.id});if(compareMoney(refund.money,'0.1')||refund.assetId!==e.known('cash-b'))throw new DomainError('ACCEPTANCE_READBACK_MISMATCH','退款金额或资产编辑未回拉');
 await e.write('extended-refund-delete','ledger.delete',{bills:[{id:refund.id,expectedVersion:refund.editVersion}]});await e.synchronize();source=await e.read('ledger.detail',{id:source.id});if(source.refundIds.length)throw new DomainError('ACCEPTANCE_READBACK_MISMATCH','删除退款未清除源关系');await e.write('extended-expense-delete','ledger.delete',{bills:[{id:source.id,expectedVersion:source.editVersion}]});
 for(const [kind,target]of [['ledger.transfer','cash-b'],['ledger.repayCard','installment-card']] as const){
  const label=kind==='ledger.transfer'?'extended-transfer':'extended-card';if(!e.optional(label))e.remember(label,'bill',createdBill(await e.write(label+'-create',kind,{mode:'create',bookId,fromAssetId:e.known('cash-a'),targetAssetId:e.known(target),enteredMoney:'0.4',fee:'0.1',timeSec,remark:e.prefix+label})));
  await e.synchronize();let row=await e.read('ledger.detail',{id:e.known(label)});await e.write(label+'-edit',kind,{mode:'edit',id:row.id,expectedVersion:row.editVersion,changes:{enteredMoney:'0.5',fee:'-0.1',remark:e.prefix+'转账优惠已改'}});await e.synchronize();row=await e.read('ledger.detail',{id:row.id});if(compareMoney(row.money,'0.4')||compareMoney(row.transferFee,'-0.1'))throw new DomainError('ACCEPTANCE_READBACK_MISMATCH','转账或还款优惠编辑未回拉');await e.write(label+'-delete',kind,{mode:'delete',id:row.id,expectedVersion:row.editVersion});
 }
 await e.synchronize();for(const alias of Object.keys(balances)){const id=e.known(alias);e.invalidateSource(assetInfoKey(id));const asset=(await e.read('assets.detail',{id},true)).asset;if(!asset||compareMoney(asset.money,balances[alias]!))throw new DomainError('ACCEPTANCE_READBACK_MISMATCH','扩展新增/编辑/删除未恢复测试资产原余额');}
 return {state:'ready',ordinaryFinancialAndMetadataEditRefundEditDeleteTransferAndCardLifecycle:true,assetBalancesRestored:true};
}
