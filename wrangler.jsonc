{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qianji-personal",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "qianji.example.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/health"]
  },
  "durable_objects": {
    "bindings": [{ "name": "QIANJI_STATE", "class_name": "QianjiState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QianjiState"] }],
  "env": {
    "preview": {
      "name": "qianji-personal-preview",
      "routes": [],
      "durable_objects": { "bindings": [{ "name": "QIANJI_STATE", "class_name": "QianjiState" }] }
    }
  }
}
